{
  "description": "DevFlow multi-agent workflow activation",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/devflow-activate.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

